// Phase 2C.2 redundancy-threshold characterization benchmark.
// Labels (category -> expectedLabel, see expectedLabelForCategory) were fixed
// BEFORE any pair's real-model similarity was inspected. Do not edit a label
// after seeing a score -- rerun the benchmark and report the real result instead.
{"id":"rest-api-a1","domain":"rest-api","category":"A","contentA":"phase2c-pilot REST endpoints use plural resource paths such as /notes and /tasks.","contentB":"REST API resources should use plural nouns in endpoint paths, such as /notes and /tasks.","notes":"KNOWN: Phase 2C.1 Pilot #1 project/global pair, real similarity ~0.805"}
{"id":"rest-api-a2","domain":"rest-api","category":"A","contentA":"REST API resources should use plural nouns in endpoint paths, such as /notes and /tasks.","contentB":"REST API resources should use plural nouns in endpoint paths, such as /tasks and /notes.","notes":"KNOWN: Phase 2C.1 Pilot #1 global/global duplicate, real similarity ~0.9996"}
{"id":"rest-api-b","domain":"rest-api","category":"B","contentA":"New REST endpoints must expose collection resources with plural, lowercase path segments (e.g. /orders, /invoices).","contentB":"When adding an HTTP API route for a collection of records, name it using a lowercase plural noun rather than a singular or verb-based path.","notes":null}
{"id":"rest-api-c","domain":"rest-api","category":"C","contentA":"REST endpoints must use plural nouns for resource paths, e.g. /notes and /tasks.","contentB":"REST endpoints must version their path with a leading /v1, /v2 segment before the resource name.","notes":null}
{"id":"rest-api-d","domain":"rest-api","category":"D","contentA":"REST API resources should use plural nouns in endpoint paths, such as /notes and /tasks.","contentB":"Background jobs must be retried with exponential backoff and a maximum of 5 attempts before moving to a dead-letter queue.","notes":null}
{"id":"validation-a","domain":"validation","category":"A","contentA":"API request payloads must be validated with Zod schemas before business logic executes.","contentB":"API request payloads must be validated using Zod schemas before business logic runs.","notes":null}
{"id":"validation-b","domain":"validation","category":"B","contentA":"phase2c-validation-pilot API request payloads must be validated with Zod schemas at the HTTP boundary before service-layer execution.","contentB":"API input should be validated with Zod schemas before business logic executes.","notes":"KNOWN: Phase 2C.1 Pilot #2 intended paraphrase-redundant pair, real similarity 0.634876"}
{"id":"validation-c","domain":"validation","category":"C","contentA":"phase2c-validation-pilot API request payloads must be validated with Zod schemas at the HTTP boundary before service-layer execution.","contentB":"phase2c-validation-pilot service functions must not depend on HTTP framework request or response objects. Route handlers must translate validated inputs into plain service arguments.","notes":"KNOWN: Phase 2C.1 Pilot #2 intentionally distinct pair, real similarity 0.749969 -- a near-miss just below 0.75"}
{"id":"validation-d","domain":"validation","category":"D","contentA":"API input should be validated with Zod schemas before business logic executes.","contentB":"CSV exports must stream row-by-row rather than building the full file in memory.","notes":null}
{"id":"repository-database-a","domain":"repository-database","category":"A","contentA":"Database access must go through repository interfaces; route handlers must never access the database directly.","contentB":"Database access must always go through a repository interface; route handlers should never touch the database directly.","notes":null}
{"id":"repository-database-b","domain":"repository-database","category":"B","contentA":"Database access must go through repository interfaces; route handlers must never access the database directly.","contentB":"Data persistence is only reachable through a dedicated repository layer, keeping SQL and ORM calls out of controller and handler code entirely.","notes":null}
{"id":"repository-database-c","domain":"repository-database","category":"C","contentA":"Database access must go through repository interfaces; route handlers must never access the database directly.","contentB":"Every database write must run inside an explicit transaction so partial failures never leave related tables inconsistent.","notes":null}
{"id":"repository-database-d","domain":"repository-database","category":"D","contentA":"Database access must go through repository interfaces; route handlers must never access the database directly.","contentB":"All public API responses must set a `Cache-Control` header appropriate to how often that resource changes.","notes":null}
{"id":"typescript-conventions-a","domain":"typescript-conventions","category":"A","contentA":"Enable strict mode in tsconfig.json for every package; no package may opt out.","contentB":"Every package's tsconfig.json must enable strict mode; opting out is not allowed.","notes":null}
{"id":"typescript-conventions-b","domain":"typescript-conventions","category":"B","contentA":"Enable strict mode in tsconfig.json for every package; no package may opt out.","contentB":"Type-checking across the codebase should be maximally rigorous by default, so all of TypeScript's strictness flags stay on in every workspace.","notes":null}
{"id":"typescript-conventions-c","domain":"typescript-conventions","category":"C","contentA":"Enable strict mode in tsconfig.json for every package; no package may opt out.","contentB":"Never use any in exported function signatures; prefer unknown with a narrowing check at the boundary.","notes":null}
{"id":"typescript-conventions-d","domain":"typescript-conventions","category":"D","contentA":"Enable strict mode in tsconfig.json for every package; no package may opt out.","contentB":"Passwords must be hashed with argon2id, never stored or logged in plaintext.","notes":null}
{"id":"testing-a","domain":"testing","category":"A","contentA":"Unit tests must not make real network calls; mock or fake every external dependency.","contentB":"Unit tests must never make real network calls; every external dependency should be mocked or faked.","notes":null}
{"id":"testing-b","domain":"testing","category":"B","contentA":"Unit tests must not make real network calls; mock or fake every external dependency.","contentB":"Keep the fast test suite hermetic: nothing in it should reach out over the network, so anything external gets a test double instead.","notes":null}
{"id":"testing-c","domain":"testing","category":"C","contentA":"Unit tests must not make real network calls; mock or fake every external dependency.","contentB":"Every bug fix must ship with a regression test that fails on the old code and passes on the fix.","notes":null}
{"id":"testing-d","domain":"testing","category":"D","contentA":"Unit tests must not make real network calls; mock or fake every external dependency.","contentB":"Feature flags must have an explicit owner and a removal date recorded when they are created.","notes":null}
{"id":"error-handling-a","domain":"error-handling","category":"A","contentA":"Never swallow an error silently; log it or rethrow it, but always surface the failure.","contentB":"Never silently swallow an error; either log it or rethrow it, but the failure must always surface.","notes":null}
{"id":"error-handling-b","domain":"error-handling","category":"B","contentA":"Never swallow an error silently; log it or rethrow it, but always surface the failure.","contentB":"A catch block that does nothing with the exception it caught is a bug -- every failure path needs to end up visible somewhere, whether that's a log line or a re-thrown error.","notes":null}
{"id":"error-handling-c","domain":"error-handling","category":"C","contentA":"Never swallow an error silently; log it or rethrow it, but always surface the failure.","contentB":"Client-caused errors (bad input) must return 4xx; server-caused errors must return 5xx. Never conflate the two.","notes":null}
{"id":"error-handling-d","domain":"error-handling","category":"D","contentA":"Never swallow an error silently; log it or rethrow it, but always surface the failure.","contentB":"Database migrations must be additive within a release; destructive schema changes ship in a separate, later release.","notes":null}
{"id":"authentication-a","domain":"authentication","category":"A","contentA":"Session tokens must be stored in an httpOnly, secure cookie, never in localStorage.","contentB":"Session tokens must always be stored in an httpOnly, secure cookie and never placed in localStorage.","notes":null}
{"id":"authentication-b","domain":"authentication","category":"B","contentA":"Session tokens must be stored in an httpOnly, secure cookie, never in localStorage.","contentB":"Client-side JavaScript should never be able to read the user's session credential directly, so it belongs in a cookie the browser protects, not in any storage a script can access.","notes":null}
{"id":"authentication-c","domain":"authentication","category":"C","contentA":"Session tokens must be stored in an httpOnly, secure cookie, never in localStorage.","contentB":"Failed login attempts must be rate-limited per account to at most 5 per 15 minutes.","notes":null}
{"id":"authentication-d","domain":"authentication","category":"D","contentA":"Session tokens must be stored in an httpOnly, secure cookie, never in localStorage.","contentB":"Every public function exported from a package's entry point needs a corresponding entry in that package's CHANGELOG when its behavior changes.","notes":null}
{"id":"logging-a","domain":"logging","category":"A","contentA":"Log lines must be structured JSON with a consistent level, message, and timestamp field.","contentB":"Every log line must be structured JSON containing a level, message, and timestamp field, consistently.","notes":null}
{"id":"logging-b","domain":"logging","category":"B","contentA":"Log lines must be structured JSON with a consistent level, message, and timestamp field.","contentB":"Application logs should be machine-parseable rather than free text, so every emitted line needs the same shape: a severity, a human-readable message, and when it happened.","notes":null}
{"id":"logging-c","domain":"logging","category":"C","contentA":"Log lines must be structured JSON with a consistent level, message, and timestamp field.","contentB":"Never log a raw request body or auth header; redact known-sensitive fields before a log line is emitted.","notes":null}
{"id":"logging-d","domain":"logging","category":"D","contentA":"Log lines must be structured JSON with a consistent level, message, and timestamp field.","contentB":"Long-running exports must run as a background job and notify the user on completion rather than blocking the HTTP request.","notes":null}
{"id":"caching-a","domain":"caching","category":"A","contentA":"Cached values must have an explicit TTL; nothing is cached indefinitely.","contentB":"Every cached value must have an explicit TTL -- nothing should be cached indefinitely.","notes":null}
{"id":"caching-b","domain":"caching","category":"B","contentA":"Cached values must have an explicit TTL; nothing is cached indefinitely.","contentB":"Anything the system caches needs a defined expiry so stale data cannot live in the cache forever without one.","notes":null}
{"id":"caching-c","domain":"caching","category":"C","contentA":"Cached values must have an explicit TTL; nothing is cached indefinitely.","contentB":"Cache keys must include the tenant id so one tenant's cached data can never be served to another.","notes":null}
{"id":"caching-d","domain":"caching","category":"D","contentA":"Cached values must have an explicit TTL; nothing is cached indefinitely.","contentB":"Database connection pools must cap max connections per process to avoid exhausting the database server's connection limit.","notes":null}
{"id":"service-boundaries-a","domain":"service-boundaries","category":"A","contentA":"Service functions must not depend on HTTP framework request or response objects.","contentB":"Service-layer functions must not depend on the HTTP framework's request or response objects.","notes":null}
{"id":"service-boundaries-b","domain":"service-boundaries","category":"B","contentA":"Service functions must not depend on HTTP framework request or response objects.","contentB":"Business logic should be fully transport-agnostic -- nothing in the service layer may assume it was invoked over HTTP, gRPC, or any other specific protocol.","notes":null}
{"id":"service-boundaries-c","domain":"service-boundaries","category":"C","contentA":"Service functions must not depend on HTTP framework request or response objects.","contentB":"Service functions must be pure with respect to I/O: all database and network calls happen through injected dependencies, never imported directly.","notes":null}
{"id":"service-boundaries-d","domain":"service-boundaries","category":"D","contentA":"Service functions must not depend on HTTP framework request or response objects.","contentB":"CI must run the full test suite on every pull request before merge is allowed.","notes":null}

{
  "name": "@brain/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/db.test.js\" \"dist-test/event-store.test.js\" \"dist-test/memory-repository.test.js\" \"dist-test/retrieval-store.test.js\" \"dist-test/codebase-repository.test.js\" \"dist-test/code-search-store.test.js\" \"dist-test/code-dependency-store.test.js\"",
    "pretest:integration": "tsc -p tsconfig.test.json",
    "test:integration": "node --test \"dist-test/local-embedding-provider.test.js\" \"dist-test/code-search-store-integration.test.js\""
  },
  "dependencies": {
    "@brain/contracts": "0.1.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@brain/test-fixtures": "0.1.0"
  }
}

{
  "name": "@brain/visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/server/**/*.test.js\" && vitest run",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@brain/contracts": "0.1.0",
    "@brain/learning": "0.1.0",
    "@brain/storage": "0.1.0",
    "d3-force": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@brain/test-fixtures": "0.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}

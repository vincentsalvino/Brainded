{
  "name": "ai-brain",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "packages/core/*"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace=@brain/contracts",
    "build:core": "npm run build --workspace=@brain/compression --workspace=@brain/context --workspace=@brain/learning --workspace=@brain/memory --workspace=@brain/ranking --workspace=@brain/retrieval --workspace=@brain/test-fixtures --workspace=@brain/token",
    "build:services": "npm run build --workspace=@brain/storage --workspace=@brain/codebase --workspace=@brain/evaluation --workspace=@brain/gateway --workspace=@brain/knowledge",
    "build:dependencies": "npm run build:contracts && npm run build:core && npm run build:services",
    "build": "npm run build:dependencies && npm run build --workspace=@brain/mcp --workspace=@brain/visualizer",
    "typecheck": "npm run build:dependencies && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build && npm run typecheck --workspaces --if-present && npm test",
    "mcp": "node packages/mcp/dist/server.js data/brain.db",
    "visualizer": "npm run dev --workspace=@brain/visualizer",
    "dev": "npm run dev --workspace=@brain/visualizer",
    "validate:brain": "npm run build:dependencies && node packages/evaluation/validation/run.mjs",
    "package:mcp": "node scripts/pack-mcp.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "esbuild": "0.25.12",
    "@types/node": "^24.0.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5"
  }
}
